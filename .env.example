# Copy to .env for local notes; the app reads real environment variables.
# In VS Code PowerShell:  $env:SECRET_KEY="..."   |  macOS/Linux:  export SECRET_KEY="..."
SECRET_KEY=replace-with-a-long-random-string      # python -c "import secrets;print(secrets.token_hex(32))"
ADMIN_PASSWORD=                                    # optional; if empty a random first-run password is printed
DATABASE_URL=                                      # optional; default is local SQLite. e.g. postgresql://user:pw@host/db
IDLE_MINUTES=30
HTTPS=0                                            # set to 1 when served over HTTPS
